# These are BUILD-TIME fallbacks only — used for the browser tab title
# (Next.js can't fetch live data before that renders) and as the very first
# paint before the dashboard's live fetch from GET /api/settings resolves.
#
# The actual source of truth for the agent/company name shown throughout
# the dashboard is the Supabase `settings` table — editable live from the
# Settings page, no rebuild needed. Keep these roughly in sync with your
# backend .env's AGENT_NAME/COMPANY_NAME so the first paint doesn't flash
# the wrong name before the live fetch completes.

NEXT_PUBLIC_AGENT_NAME=Velu
NEXT_PUBLIC_COMPANY_NAME=Technozis
NEXT_PUBLIC_APP_VERSION=3.0.0

# ─── Server-side only — never prefix these with NEXT_PUBLIC_ ──────────────
# Read by app/api/[...path]/route.js, which proxies every /api/* call from
# the browser to the backend and attaches the dashboard credential there —
# the browser itself never sees either of these values.
#
# BACKEND_INTERNAL_URL — where the Next.js SERVER reaches the backend from
# (in docker-compose: the "backend" service name; in k8s: the backend
# Service's in-cluster DNS name).
BACKEND_INTERNAL_URL=http://localhost:8000
# Must match DASHBOARD_ADMIN_KEY in the backend's .env.
DASHBOARD_ADMIN_KEY=b296131f0e1d042851dd5512a0d12e2fd9b2d0ccaf550edc6c3476b776b599b8
DASHBOARD_SESSION_SECRET=fe352c9727495ecf9af5d3ab6cc4a0ef30714a9e3b9c513c95fda584f632f385

# VA-T-002 — dashboard sign-in.
#
# This is NOT a password and nobody types it. It is the key the backend signs
# session tokens with and this frontend verifies them with, so middleware can
# check a session on every request without a database round trip.
#
# It must be IDENTICAL to DASHBOARD_SESSION_SECRET in the backend .env, or
# every login will appear to succeed and then immediately bounce back to the
# sign-in page.
#
# Logins themselves are per-user accounts with Argon2id hashes in the `users`
# table — create one with: python scripts/create_user.py
#
# Generate with: openssl rand -hex 32
DASHBOARD_SESSION_TTL_HOURS=12
