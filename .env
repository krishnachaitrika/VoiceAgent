# ═══════════════════════════════════════════════════════════════════════════
#  Voice Agent — deployment configuration
# ═══════════════════════════════════════════════════════════════════════════
#
#  WHAT BELONGS IN THIS FILE
#
#  Only what THIS deployment knows that the code cannot:
#
#    1. Secrets          API keys, passwords, connection strings
#    2. Addresses        where this install's database, Redis and public
#                        hostname actually are
#    3. Identity         which company this instance answers for
#    4. Commercial       the rates YOUR provider accounts are billed at
#    5. Topology         what sits in front of this process
#
#  Everything else — models, timeouts, VAD tuning, buffer sizes, feature
#  flags, cache TTLs — has a working default in backend/config.py. Those
#  defaults were tuned against real calls, so repeating them here only
#  creates a second copy that can silently drift from the code.
#
#  This file was 81 variables. 58 of them were byte-identical to their
#  config.py default: pure duplication, and a trap. Someone improving a
#  default in code would have had no effect on any deployment still
#  pinning the old value here, and nothing would have said so.
#
#  TO OVERRIDE A DEFAULT: look it up in backend/config.py, add the line
#  here, and note why. A value in this file should always be an answer to
#  "what is different about this install?"
#
#  A fresh clone with only the REQUIRED block below must boot and run.
# ═══════════════════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────────────────
#  REQUIRED — the service will not work without these
# ───────────────────────────────────────────────────────────────────────────

# --- AI -------------------------------------------------------------------
OPENAI_API_KEY=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
# STT has NO fallback provider. Without this every call fails to transcribe
# the caller, and startup says so.
ELEVENLABS_API_KEY= sk_0b63d6e8b8af3728517b5d6d46ad46074988736c2b3bb5ad

# TTS. Sarvam Bulbul is the default spoken voice; see ELEVENLABS_VOICE_ID
# under OPTIONAL to switch.
SARVAM_API_KEY=

# --- Telephony ------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+91XXXXXXXXXX

# --- Database -------------------------------------------------------------
# Must use the asyncpg driver. A sync URL fails on the first query, not at
# startup — so it looks fine until a call arrives.
DATABASE_URL= postgresql://postgres.bdauyvyyecqfrfmezyjr:KSR257%40technozis2027@aws-1-ap-south-1.pooler.supabase.com:5432/postgres

# --- Dashboard access -----------------------------------------------------
# Generate each with: openssl rand -hex 32
#
# The API refuses every /api/dashboard, /api/settings, /api/documents and
# /api/analytics request when these are blank.
DASHBOARD_ADMIN_KEY=b296131f0e1d042851dd5512a0d12e2fd9b2d0ccaf550edc6c3476b776b599b8
DASHBOARD_SESSION_SECRET=fe352c9727495ecf9af5d3ab6cc4a0ef30714a9e3b9c513c95fda584f632f385
DASHBOARD_API_KEY=2079d508404712d29b00515d53853dce99d7a3714e191b3705b40794093ea3a0
# VA-T-002 — dashboard sign-in. Before this existed the console had no login
# at all: its proxy attached the admin key to every request, so anyone who
# could reach the host saw call transcripts and caller phone numbers.
#
# This is NOT a password and nobody types it. It is the key that signs session
# tokens, so the frontend can verify a session without a database round trip
# on every request. It must be IDENTICAL to DASHBOARD_SESSION_SECRET in
# frontend/.env, or logins succeed and then immediately bounce back to the
# sign-in page.
#
# Rotating it invalidates every live session at once — the lever to pull when
# a session must die before it expires.
#
# LOGINS ARE PER-USER ACCOUNTS, not a shared password: usernames and Argon2id
# hashes live in the `users` table (migration 0005). No account is seeded —
# create the first one deliberately:
#     python scripts/create_user.py

# --- Public address -------------------------------------------------------
# Where Twilio reaches this service. ngrok is fine for development; a
# production deployment needs a stable hostname with TLS.
NGROK_URL=https://xxxx.ngrok.io


# ───────────────────────────────────────────────────────────────────────────
#  IDENTITY — which company this instance answers for
# ───────────────────────────────────────────────────────────────────────────
#  Genuinely per-deployment: the same image serving a second client differs
#  in exactly these values and nothing else.

AGENT_NAME=Velu
COMPANY_NAME=Technozis
COMPANY_DESCRIPTION="an enterprise AI services company based in the United Kingdom"

# VA-T-015 — the first sentence of EVERY call. It must not offer a language
# this build cannot answer in: the build is English-only, and startup now
# REFUSES to boot in production if the greeting names another language.
# {agent_name} and {company_name} are substituted automatically.
GREETING_TEMPLATE="Hello! Thank you for calling {company_name}. I'm {agent_name}, your AI assistant. How can I help you today?"


# ───────────────────────────────────────────────────────────────────────────
#  INFRASTRUCTURE
# ───────────────────────────────────────────────────────────────────────────

# Redis. docker-compose builds REDIS_URL itself from REDIS_PASSWORD and
# overrides this — set it directly only when running outside compose.
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# Exact origins (scheme+host+port, no trailing slash) allowed to call this
# API with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# "production" makes a configuration error REFUSE to boot instead of being
# discovered on a live call. Anything else logs and continues.
ENVIRONMENT=development

# VA-T-006 — the rate limiter keys on the socket peer, which behind a proxy
# is the proxy: every dashboard user shared one bucket, and the webhook limit
# became a GLOBAL cap on inbound calls rather than a per-client guard.
#
# X-Forwarded-For is trusted ONLY from addresses listed here, because the
# header is otherwise trivially forged. Blank is correct for a direct run.
#   docker-compose : 172.16.0.0/12
#   Kubernetes     : your pod CIDR, e.g. 10.0.0.0/8
RATE_LIMIT_TRUSTED_PROXIES=

# VA-T-011 — must mirror terminationGracePeriodSeconds in
# k8s/04-backend-deployment.yaml. Startup compares the two and complains if
# the shutdown budget does not fit inside it.
PLATFORM_TERMINATION_GRACE_SEC=60


# ───────────────────────────────────────────────────────────────────────────
#  COMMERCIAL — your accounts' actual rates
# ───────────────────────────────────────────────────────────────────────────
#  These default to 0.0 in config.py ON PURPOSE. A plausible-looking wrong
#  rate is worse than an obvious zero: an outbound Twilio rate estimated at
#  $0.12/min against a real $0.0699 overstated every outbound call by 42%
#  and looked entirely credible in the dashboard.
#
#  Set them from YOUR invoices. Startup lists any left unset.

# Login hardening. Password hashing protects a leaked database; it does
# nothing against someone guessing at the login endpoint, where the attacker
# never sees a hash. Defaults are in config.py — override only if 5 attempts
# / 15 minutes does not suit.
# LOGIN_MAX_FAILED_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15
# RATE_LIMIT_LOGIN=10/minute


ELEVENLABS_STT_COST_PER_MINUTE=0.004
SARVAM_TTS_COST_PER_1K_CHARS=0.02
ELEVENLABS_TTS_COST_PER_1K_CHARS=0.10

# Inbound is still an estimate — every test call so far has been outbound.
TWILIO_INBOUND_COST_PER_MINUTE=0.0085

# VERIFIED against 11 invoiced calls on this account. Twilio rounds UP to the
# whole minute (124s billed as 3 minutes), which the code already models.
TWILIO_OUTBOUND_COST_PER_MINUTE=0.0699

# Twilio publishes a call's real price over an hour after it ends, so the
# in-process retry window can never catch it. Left off until a scheduled
# sweep job exists; the rate above is verified, so the calculated figure is
# correct meanwhile.
TWILIO_RECONCILE_PRICE=false


# ───────────────────────────────────────────────────────────────────────────
#  OPTIONAL
# ───────────────────────────────────────────────────────────────────────────

# Fill in a real ElevenLabs voice ID to switch TTS from Sarvam Bulbul to your
# cloned voice — the same switch as the Settings page's voice dropdown.
ELEVENLABS_VOICE_ID=

# Google Calendar. Meetings still save to the database without it.
GOOGLE_CALENDAR_ID=primary
GOOGLE_CREDENTIALS_JSON=credentials.json
GOOGLE_CALENDAR_TIMEZONE=Asia/Kolkata


# ═══════════════════════════════════════════════════════════════════════════
#  REMOVED — 58 variables that only repeated their config.py default
# ═══════════════════════════════════════════════════════════════════════════
#  Deleting them changes NOTHING: each was byte-identical to the default,
#  verified by comparison before removal. They are listed here so nobody
#  wonders where a familiar name went.
#
#    models / tuning    ELEVENLABS_STT_*, ELEVENLABS_TTS_*, SARVAM_TTS_*
#    turn-taking        SMART_HEARING_*, MULTI_PART_*, TURN_PREEMPT_GRACE_MS
#    resilience         STT_RECONNECT_*
#    brain              ROLLING_MEMORY_*, SENTIMENT_MODEL,
#                       ORCHESTRATOR_ROUTER_MODEL, STICKY_ROUTE_TTL,
#                       RAG_RELEVANCE_THRESHOLD
#    feature flags      ENABLE_GUARDRAILS, ENABLE_ROLLING_MEMORY,
#                       ENABLE_SENTIMENT_ANALYTICS, ENABLE_EVENT_BUS,
#                       ENABLE_SMART_HEARING, ENABLE_MULTI_PART_MERGE,
#                       ENABLE_STREAMING_STT, ENABLE_STREAMING_TTS
#    caches             REDIS_ENABLED, REDIS_*_TTL
#    misc               APP_VERSION
#
#  Also removed as dead: TWILIO_RECONCILE_DELAY_SEC and
#  TWILIO_RECONCILE_MAX_ATTEMPTS — they only apply when
#  TWILIO_RECONCILE_PRICE is true, so keeping them invites someone to tune a
#  value that does nothing.
#
#  To override any of the above, look it up in backend/config.py, add the
#  line back, and say why in a comment.
# ═══════════════════════════════════════════════════════════════════════════

